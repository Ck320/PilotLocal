{
    "name": "ollama-local-chat",
    "displayName": "Ollama Local Chat",
    "description": "Chat local com modelos Ollama e menção de arquivos via @ no VSCodium",
    "version": "0.2.0",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "AI",
        "Chat"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "ollama-chat-sidebar",
                    "title": "Ollama Chat",
                    "icon": "$(comment-discussion)"
                }
            ]
        },
        "views": {
            "ollama-chat-sidebar": [
                {
                    "type": "webview",
                    "id": "ollamaChatView",
                    "name": "Chat Local"
                }
            ]
        },
        "commands": [
            {
                "command": "ollamaLocal.clearChat",
                "title": "Ollama: Limpar Histórico do Chat",
                "icon": "$(clear-all)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "ollamaLocal.clearChat",
                    "when": "view == ollamaChatView",
                    "group": "navigation"
                }
            ]
        },
        "configuration": {
            "title": "Ollama Local Chat",
            "properties": {
                "ollamaLocal.host": {
                    "type": "string",
                    "default": "http://localhost:11434",
                    "description": "URL base do servidor local do Ollama"
                },
                "ollamaLocal.model": {
                    "type": "string",
                    "default": "qwen3:8b",
                    "description": "Modelo padrão do Ollama"
                },
                "ollamaLocal.embeddingModel": {
                    "type": "string",
                    "default": "nomic-embed-text:latest",
                    "description": "Modelo local do Ollama usado para embeddings e busca semântica nos arquivos"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/node": "^20.19.43",
        "@types/vscode": "^1.85.0",
        "typescript": "^5.4.0"
    }
}